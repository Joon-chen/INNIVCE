APP_ENV=local
APP_SECRET_KEY=change-me
ADMIN_API_TOKEN=
API_BASE_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql+psycopg://advisor:advisor@postgres:5432/advisor
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=local_hash
LOCAL_EMBEDDING_SIZE=384
OPENAI_USE_FOR_REPORTS=false
OPENAI_USE_FOR_EXTRACTION=false
OPENAI_USE_FOR_BOT=true
AI_PROVIDER=hybrid
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5:14b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_USE_FOR_REPORTS=true
DEEPSEEK_USE_FOR_EXTRACTION=true
DEEPSEEK_USE_FOR_BOT_ANALYSIS=true
BOT_LLM_SEMANTICS_ENABLED=true
BOT_LLM_ANSWER_REWRITE_ENABLED=true
BOT_LLM_ANSWER_REWRITE_MAX_CHARS=2600

FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_EVENT_TOKEN=
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/feishu/oauth/callback
FEISHU_BOT_MODEL_CONTEXT_EVENTS=18
FEISHU_SYNC_CONTACTS_TO_BOT_USERS=true

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=work_events
QDRANT_ENABLED=true
QDRANT_SCORE_THRESHOLD=0.25

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=advisor-attachments

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/mail/gmail/oauth/callback

MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_REDIRECT_URI=http://localhost:8000/api/mail/graph/oauth/callback

AUTO_IMAP_SYNC_ENABLED=false
AUTO_IMAP_ACCOUNT_IDS=
AUTO_IMAP_FOLDER=INBOX
AUTO_IMAP_LIMIT=50
AUTO_IMAP_INTERVAL_SECONDS=1800

AUTO_DAILY_REPORT_ENABLED=false
AUTO_DAILY_REPORT_COMPANY_IDS=
AUTO_DAILY_REPORT_HOUR=18
AUTO_DAILY_REPORT_MINUTE=30
AUTO_DAILY_REPORT_PUSH_FEISHU=false
AUTO_FEISHU_SYNC_ENABLED=false
AUTO_FEISHU_APP_CONFIG_IDS=
AUTO_FEISHU_SYNC_KINDS=mail,chats,contacts,calendar,tasks,meetings,drive
AUTO_FEISHU_SYNC_INTERVAL_SECONDS=1800
AUTO_FEISHU_SYNC_LIMIT=50
AUTO_FEISHU_MAIL_USER_MAILBOX_ID=
AUTO_FEISHU_MAIL_FOLDER_ID=INBOX

AUTO_V5_RESOURCE_SYNC_ENABLED=true
AUTO_V5_RESOURCE_SYNC_INTERVAL_SECONDS=900
AUTO_V5_RESOURCE_SYNC_LIMIT_RESOURCES=10
AUTO_V5_RESOURCE_SYNC_EVENT_LIMIT=20
AUTO_V5_RESOURCE_SYNC_MAX_PAGES=2
AUTO_V5_RESOURCE_SYNC_RESOURCE_TYPES=approval,chat,calendar,meeting,task,directory
AUTO_V5_RESOURCE_SYNC_STATUSES=never_synced,stale

FEISHU_DEFAULT_APP_CONFIG_ID=
FEISHU_DEFAULT_RECEIVE_ID_TYPE=open_id
FEISHU_DEFAULT_RECEIVE_ID=
FEISHU_WS_ENABLED=false
FEISHU_BOT_AI_MODE_ENABLED=true
FEISHU_BOT_CONTEXT_EVENTS=80
FEISHU_BOT_ADMIN_OPEN_IDS=

FEISHU_BOT_RUNTIME_V5_ENABLED=false
